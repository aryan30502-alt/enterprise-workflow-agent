# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Groq LLM (Primary, Fast & Free) ─────────────────────────────────────────
# Get your key from: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ── Google Gemini LLM (Secondary Fallback) ──────────────────────────────────
# Get your key from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# ── OpenRouter LLM (Optional Tertiary Fallback) ─────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── Google Sheets (OAuth Desktop Flow) ───────────────────────────────────────
# Path to the downloaded OAuth Desktop JSON key file.
# Place it at: credentials/credentials.json
GOOGLE_CREDENTIALS_PATH=credentials/credentials.json

# Path where the generated OAuth token will be cached
GOOGLE_TOKEN_PATH=credentials/token.json

# The target Spreadsheet ID from the Google Sheet URL:
# https://docs.google.com/spreadsheets/d/[THIS_PART]/edit
# Note: If the OAuth user does not have write access to this sheet,
# the agent will automatically provision a new sheet.
GOOGLE_SHEET_ID=your_spreadsheet_id_here

# ── Agent Behaviour ────────────────────────────────────────────────────────────
# Maximum LangGraph loop iterations (prevents runaway loops)
MAX_AGENT_STEPS=15

# Maximum agent-level retries per failing tool
MAX_TOOL_RETRIES=2

# Directory where generated CSV and XLSX files will be saved
OUTPUT_DIR=output

# ── Logging ────────────────────────────────────────────────────────────────────
# Options: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Options: console (human-readable) | json (machine-parseable)
LOG_FORMAT=console
